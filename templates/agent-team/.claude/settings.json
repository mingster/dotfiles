{
  "agent": "elon",
  "model": "sonnet",
  "effortLevel": "medium",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.md\"; bash \"$CLAUDE_PROJECT_DIR/.claude/bin/state-of-play.sh\""
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Context was compacted. Keep your role from before (Tech Lead unless you were spawned as a teammate or subagent). Do not re-scan the state of play: continue from TaskList and the last owner message.'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/strikes.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/strikes.py\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bin/promote-production.sh:*)",
      "Bash(./bin/promote-production.sh:*)"
    ],
    "ask": [
      "Bash(git push origin main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin *:production*)",
      "Bash(git push origin *:refs/heads/production*)",
      "Bash(ssh root@stm36.tvcdn.org*)",
      "Bash(gh api *branches/production/protection*)",
      "Bash(git push origin +*)",
      "Bash(*SCHEMA_APPROVED=1*)"
    ],
    "deny": [
      "Bash(gh pr merge * --admin*)",
      "Bash(gh * pr merge * --admin*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/*.p8)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)"
    ]
  }
}
