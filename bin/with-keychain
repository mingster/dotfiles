#!/bin/sh
# Run a command with API keys or tokens read from the macOS keychain, for that command only.
# Usage: with-keychain NAME [NAME...] -- command [args...]
# Each NAME is a generic password in the login keychain (account = $USER, service = NAME) and becomes
# an environment variable of that name for the command. Nothing is written to a file or exported to
# the calling shell. A name missing from the keychain stops the run, naming the item and never a value.
names=
while [ $# -gt 0 ] && [ "$1" != -- ]; do names="$names $1"; shift; done
[ "${1:-}" = -- ] && [ -n "$names" ] && [ $# -ge 2 ] || { echo 'Usage: with-keychain NAME [NAME...] -- command [args...]' >&2; exit 2; }
shift
for name in $names; do
  value=$(security find-generic-password -a "$USER" -s "$name" -w 2>/dev/null) || {
    echo "with-keychain: no keychain item '$name' for account $USER. See docs/agents/keys-in-keychain.md" >&2
    exit 1
  }
  export "$name=$value"
done
exec "$@"
