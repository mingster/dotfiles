#!/usr/bin/env bash

# Stow all packages under .config (same tree as install.sh: use ~/dotfiles).

DOTFILES="${DOTFILES:-$HOME/dotfiles}"
CONFIG_DIR="${DOTFILES}/.config"

SCRIPT_DEBUG=true
#SCRIPT_DEBUG=false

clrstandout=$(tput smso 2>/dev/null || true) # Inverse - marks beginning end of this script
clrcommand=$(tput bold 2>/dev/null || true) # bold - marks calling other functions or scripts
clrunder=$(tput smul 2>/dev/null || true) # underline - marks comments
clrwarning=$(tput setaf 3 2>/dev/null || true) # yellow - marks warnings
clrerror=$(tput setaf 1 2>/dev/null || true) # red - marks errors
clrreset=$(tput sgr0 2>/dev/null || true) #normal - resets all

if $SCRIPT_DEBUG; then echo "${clrstandout}Stowing files in ${CONFIG_DIR}.${clrreset}"; fi

if ! command -v stow >/dev/null 2>&1; then
  echo "${clrerror}stow is not installed. Install it first (brew install stow).${clrreset}" >&2
  exit 1
fi

cd "$CONFIG_DIR" || exit 1
failed=()
for files in "$CONFIG_DIR"/*; do
  if [ -d "${files}" ]; then
    pkg=$(basename "$files")
    if stow -R "$pkg"; then
      if $SCRIPT_DEBUG; then echo "$pkg stowed."; fi
    else
      echo "${clrerror}$pkg failed to stow.${clrreset}" >&2
      failed+=("$pkg")
    fi
  fi
done
cd - > /dev/null

if [ "${#failed[@]}" -gt 0 ]; then
  echo "${clrerror}Failed packages: ${failed[*]}${clrreset}" >&2
  exit 1
fi

if $SCRIPT_DEBUG; then echo "${clrstandout}All packages stowed or re-stowed.${clrreset}"; fi
