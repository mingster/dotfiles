# Hosted runners skip script tests that need macOS-only tools or heavy-gate host locks. Tests tagged "rerun on macOS" run in checks-local.sh on macOS.
# Format: <repo-relative test path> <reason>
script/tests/heavy-gate.test.sh fails 6 admission message tests once run (#1665); rerun on coordinator host
script/tests/fleet-watch-heavy-gate.test.sh uses heavy-gate host lock (temp HOME in the test); rerun on macOS
script/tests/heavy-guard-hook.test.sh uses heavy-gate host lock (temp HOME in the test); rerun on macOS
script/tests/install-mac-server.test.sh needs macOS Homebrew dry-run paths; rerun on macOS
script/tests/switch-login-shell-zsh.test.sh needs macOS login shell paths; rerun on macOS
script/tests/pull-project-a-pg-backups.test.sh needs macOS stat/find shims; rerun on macOS
script/secrets-pack.test.sh needs macOS hdiutil; rerun on macOS
script/tests/test_head_checks_execution.py needs Bun; rerun on macOS
