{
  "runs": [],
  "host_caps": {},
  "leads": [],
  "pr_watch": {
    "repos": ["mingster/dotfiles", "mingster/project-a"],
    "stuck_minutes": 30
  },
  "worker_stall": {
    "label_repo": "owner/name",
    "needs_elon_label": "needs-elon",
    "label_cooldown_seconds": 120
  },
  "backup": {
    "stamp": "/path/to/private/agent-state/.last-push-stamp",
    "issue_repo": "owner/name"
  },
  "heavy_gate": {
    "hosts": {
      "host-id": "/path/to/private/heavy-gate-wait.log"
    },
    "slot_roots": {
      "host-id": "/path/to/private/heavy-gate-cache"
    },
    "issue_repo": "owner/name"
  },
  "wrap_up": {
    "hosts": {
      "host-id": "/path/to/private/wrap-up-scheduled.log"
    },
    "issue_repo": "owner/name"
  },
  "issue_scan": {
    "enabled": false,
    "repos": ["owner/app"],
    "repo_roots": {"owner/app": "/path/to/checkout"},
    "run": "run_id",
    "from_terminal": "coordinator_terminal_handle",
    "host": "local",
    "agent": "cursor",
    "model": "composer-2.5"
  },
  "coordinator_watch": {
    "state_dir": "/path/to/private/state",
    "offline_minutes": 10,
    "alert_command": ["/path/to/private/notify"]
  }
}
