{
  "light_only_hosts": [],
  "runs": [],
  "go_live_date": "2099-01-01",
  "work_order": {
    "min_active": 3,
    "target_workers": 8,
    "max_workers": 8,
    "keep_target_until_go_live": false
  },
  "host_caps": {
    "primary-code-host": 4,
    "overflow-host-a": 4,
    "overflow-host-b": 4
  },
  "host_load_ceilings": {
    "primary-code-host": 12,
    "overflow-host-a": 8,
    "overflow-host-b": 12
  },
  "local_host": "primary-code-host",
  "worker_placement": {
    "load_sensor": "~/.claude/state/fleet-load.sh",
    "order": ["primary-code-host", "overflow-host-a", "overflow-host-b"],
    "recent_start_seconds": 300,
    "roles": {
      "browser-secrets-host": "browser",
      "database-heavy-host": "heavy",
      "release-host": "release"
    }
  },
  "board_stale_check": false,
  "overlap_shared_paths": [],
  "orphan_reaper": {"enabled": true},
  "worker_limits": {"soft_minutes": 60, "hard_minutes": 90, "types": {}},
  "leads": [],
  "pr_watch": {
    "repos": ["mingster/dotfiles", "mingster/project-a"],
    "stuck_minutes": 30,
    "workflows": ["Checks", "Review", "ShellCheck", "Script tests"]
  },
  "head_checks": {
    "infra_reruns": 2
  },
  "babysit": {
    "per_pass_cap": 2,
    "standing_verifier": {
      "enabled": false,
      "hosts": [],
      "agent": "antigravity",
      "model": "gemini-4-argon-high",
      "max_prs": 5,
      "wake_timeout_seconds": 90,
      "max_context_percent": 70
    }
  },
  "worker_stall": {
    "label_repo": "owner/name",
    "needs_elon_label": "needs-elon",
    "label_cooldown_seconds": 120
  },
  "backup": {
    "stamp": "/path/to/private/agent-state/.last-push-stamp",
    "issue_repo": "owner/name"
  },
  "heavy_gate": {
    "hosts": {
      "host-id": "/path/to/private/heavy-gate-wait.log"
    },
    "slot_roots": {
      "host-id": "/path/to/private/heavy-gate-cache"
    },
    "issue_repo": "owner/name"
  },
  "wrap_up": {
    "hosts": {
      "host-id": "/path/to/private/wrap-up-daily.log"
    },
    "issue_repo": "owner/name"
  },
  "issue_scan": {
    "enabled": false,
    "repos": ["owner/app"],
    "repo_roots": {"owner/app": "/path/to/checkout"},
    "run": "run_id",
    "from_terminal": "coordinator_terminal_handle",
    "host": "local",
    "agent": "cursor",
    "model": "grok-4.7-high",
    "sweep_agent": "claude",
    "sweep_model": "sonnet",
    "backlog_sweep_interval_seconds": 7200
  },
  "coordinator_watch": {
    "state_dir": "/path/to/private/state",
    "offline_minutes": 10,
    "alert_command": ["/path/to/private/notify"]
  }
}
