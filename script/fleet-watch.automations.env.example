# Copy to ~/.config/fleet-watch/automations.env (private). Used by install-fleet-automations.sh.
# DOTFILES_DIR defaults to the dotfiles checkout beside the installer.
# FLEET_WATCH_CONFIG=/path/to/private/fleet-watch.json
# FLEET_WATCH_STATE=$HOME/.local/state/agent-team/fleet-watch.state.json
# FLEET_WATCH_PRECHECK_LOG=$HOME/.local/state/agent-team/fleet-watch-precheck.log
# FLEET_AUTOMATIONS_TIMEZONE=Asia/Taipei
# SYNC_DRIFT_LOG=$HOME/.local/state/agent-team/sync-team-skills-drift.log
# TEAM_AUDIT_WEEKLY_LOG=$HOME/.local/state/agent-team/team-audit-weekly.log
